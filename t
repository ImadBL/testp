/* ============================================================
   ARCHIVAGE
   Une ligne = état d'archivage d'une case
   ============================================================ */

CREATE TABLE BCP_ARCHIVE_CASE
(
    ID                      NUMBER(19)
                                GENERATED BY DEFAULT AS IDENTITY
                                PRIMARY KEY,

    CASE_REFERENCE          VARCHAR2(255)              NOT NULL,
    CASE_TYPE               VARCHAR2(100),

    SOURCE                  VARCHAR2(30)               NOT NULL,
    JMS_MESSAGE_ID          VARCHAR2(255),

    ARCHIVE_CORRELATION_ID  VARCHAR2(100),

    ARCHIVE_STATUS          VARCHAR2(30)               NOT NULL,
    ARCHIVE_ATTEMPT_COUNT   NUMBER(10) DEFAULT 0       NOT NULL,
    ARCHIVE_DATE            TIMESTAMP WITH TIME ZONE,

    CLAIMED_BY              VARCHAR2(255),
    CLAIMED_AT              TIMESTAMP WITH TIME ZONE,

    LAST_ERROR              VARCHAR2(4000),

    VERSION                 NUMBER(19) DEFAULT 0       NOT NULL,
    CREATED_AT              TIMESTAMP WITH TIME ZONE  NOT NULL,
    UPDATED_AT              TIMESTAMP WITH TIME ZONE  NOT NULL,

    CONSTRAINT UK_BCP_ARCHIVE_CASE_REF
        UNIQUE (CASE_REFERENCE)
);


/* ============================================================
   PURGE / RETENTION
   Une ligne = une case identifiée pour la purge
   ============================================================ */

CREATE TABLE BCP_RETENTION_CASE
(
    ID                      NUMBER(19)
                                GENERATED BY DEFAULT AS IDENTITY
                                PRIMARY KEY,

    SOURCE_REQUEST_ID       NUMBER(19),

    ARCHIVE_CASE_ID         NUMBER(19),

    SOURCE_TYPE             VARCHAR2(30)               NOT NULL,

    BUSINESS_REFERENCE      VARCHAR2(255)              NOT NULL,
    CASE_REFERENCE          VARCHAR2(255)              NOT NULL,

    CASE_STATUS             VARCHAR2(50),

    CONTRACT_ID             VARCHAR2(100),
    PROPOSAL_ID             VARCHAR2(100),

    COUNTRY_ID              NUMBER(19),

    PROCESS_TYPE            VARCHAR2(100),

    ELIGIBLE                NUMBER(1) DEFAULT 0         NOT NULL,

    PURGE_STATUS            VARCHAR2(30)               NOT NULL,
    PURGE_ATTEMPT_COUNT     NUMBER(10) DEFAULT 0       NOT NULL,
    PURGE_DATE              TIMESTAMP WITH TIME ZONE,

    CLAIMED_BY              VARCHAR2(255),
    CLAIMED_AT              TIMESTAMP WITH TIME ZONE,

    LAST_ERROR              VARCHAR2(4000),

    VERSION                 NUMBER(19) DEFAULT 0       NOT NULL,
    CREATED_AT              TIMESTAMP WITH TIME ZONE  NOT NULL,
    UPDATED_AT              TIMESTAMP WITH TIME ZONE  NOT NULL,

    CONSTRAINT CK_BCP_RET_CASE_ELIGIBLE
        CHECK (ELIGIBLE IN (0, 1)),

    CONSTRAINT UK_BCP_RET_CASE_SOURCE_REF
        UNIQUE (SOURCE_TYPE, CASE_REFERENCE),

    CONSTRAINT FK_BCP_CASE_REQUEST
        FOREIGN KEY (SOURCE_REQUEST_ID)
        REFERENCES BCP_RETENTION_REQUEST (ID),

    CONSTRAINT FK_BCP_RET_CASE_ARCHIVE
        FOREIGN KEY (ARCHIVE_CASE_ID)
        REFERENCES BCP_ARCHIVE_CASE (ID),

    CONSTRAINT FK_BCP_RET_CASE_COUNTRY
        FOREIGN KEY (COUNTRY_ID)
        REFERENCES BCP_COUNTRY (ID)
);


/* ============================================================
   INDEXES
   ============================================================ */

/* Discovery des demandes */
CREATE INDEX IX_BCP_REQ_DISCOVERY
    ON BCP_RETENTION_REQUEST
       (DISCOVERY_STATUS, CLAIMED_AT, ID);


/* Recherche des archives à traiter */
CREATE INDEX IX_BCP_ARCHIVE
    ON BCP_ARCHIVE_CASE
       (ARCHIVE_STATUS, CLAIMED_AT, ID);


/* Recherche JMS / idempotence */
CREATE INDEX IX_BCP_ARCHIVE_JMS_MSG
    ON BCP_ARCHIVE_CASE
       (JMS_MESSAGE_ID);


/* Recherche des cases prêtes à purger */
CREATE INDEX IX_BCP_CASE_PURGE
    ON BCP_RETENTION_CASE
       (SOURCE_TYPE, PURGE_STATUS, CLAIMED_AT, ID);


/* Jointure purge -> archive */
CREATE INDEX IX_BCP_RET_CASE_ARCHIVE_ID
    ON BCP_RETENTION_CASE
       (ARCHIVE_CASE_ID);


/* Recherche par pays */
CREATE INDEX IX_BCP_RET_CASE_COUNTRY
    ON BCP_RETENTION_CASE
       (COUNTRY_ID);
